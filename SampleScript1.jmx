        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import org.apache.jmeter.save.CSVSaveService
import org.apache.jmeter.services.FileServer

if (props.get(&quot;CSV_ROWS&quot;) == null) {
    // Override with -Jcsv.path=/path/to/data.csv, otherwise relative to the .jmx folder
    def path = props.get(&quot;csv.path&quot;) ?: (FileServer.getFileServer().getBaseDir() + &quot;/users.csv&quot;)

    def rows = []
    def header = null

    new File(path).withReader(&quot;UTF-8&quot;) { r -&gt;
        def br = new BufferedReader(r)
        while (true) {
            String[] line = CSVSaveService.csvReadFile(br, (char) &apos;,&apos;)
            if (line.length == 0) break                           // EOF
            if (line.length == 1 &amp;&amp; line[0].trim() == &quot;&quot;) continue // skip blank lines
            if (header == null) {
                header = line.collect { it.trim() }
            } else {
                rows &lt;&lt; line.toList()
            }
        }
    }

    if (rows.isEmpty()) {
        throw new IllegalStateException(&quot;CSV has no data rows: &quot; + path)
    }

    props.put(&quot;CSV_HEADER&quot;, header)
    props.put(&quot;CSV_ROWS&quot;, rows)
    log.info(&quot;Loaded ${rows.size()} records from ${path}&quot;)
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
